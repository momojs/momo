{
  "name": "cupori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && bun run db:migrations:build",
    "db:check": "drizzle-kit check --config drizzle.config.ts && bun scripts/check-database-schema.ts && bun run db:migrations:check",
    "db:migrations:build": "bun scripts/build-database-migrations.ts",
    "db:migrations:check": "bun scripts/build-database-migrations.ts --check",
    "route:watch": "bun scripts/route-watch.ts",
    "route:generate": "tsr generate",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent",
    "i18n:watch": "bun scripts/watch-i18n.ts",
    "app:serve": "bun --hot src/index.ts",
    "app:watch": "bun run i18n:compile && bun run app:serve",
    "dev": "bun run i18n:compile && bun run --parallel route:watch i18n:watch app:serve",
    "start": "bun run i18n:compile && NODE_ENV=production bun src/index.ts",
    "build": "bun run db:check && bun run i18n:compile && bun run route:generate && bun run build.ts",
    "ios:sync": "bun run build && cap sync ios",
    "ios:open": "bun run ios:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.2",
    "@capawesome/capacitor-exif": "^0.1.1",
    "@heroicons/react": "^2.2.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@momots/core": "workspace:*",
    "@momots/design": "workspace:*",
    "@momots/drive": "workspace:*",
    "@momots/host": "workspace:*",
    "@nivo/bar": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "bun-plugin-tailwind": "^0.1.2",
    "compressorjs": "^1.3.0",
    "cva": "^1.0.0-beta.8",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "jeep-sqlite": "^2.8.0",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "react": "^19",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19",
    "remeda": "^2.39.0",
    "sql.js": "1.11.0",
    "tailwindcss": "^4.1.11",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.23.0",
    "@tanstack/router-cli": "^1.167.19",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^7.0.2"
  }
}
