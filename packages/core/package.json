{
  "name": "@momots/core",
  "version": "0.1.0-beta.2",
  "description": "Bun-first functional primitives for MomoTS packages and apps.",
  "keywords": [
    "momots",
    "functional",
    "typescript",
    "utilities",
    "pure-function",
    "tree"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./as/*": {
      "types": "./dist/as/*.d.ts",
      "import": "./dist/as/*.js"
    },
    "./cardinality": {
      "types": "./dist/cardinality.d.ts",
      "import": "./dist/cardinality.js"
    },
    "./casing": {
      "types": "./dist/casing/index.d.ts",
      "import": "./dist/casing/index.js"
    },
    "./casing/toCamelCasedProperties": {
      "types": "./dist/casing/toCamelCasedProperties.d.ts",
      "import": "./dist/casing/toCamelCasedProperties.js"
    },
    "./casing/toCamelCasedPropertiesDeep": {
      "types": "./dist/casing/toCamelCasedPropertiesDeep.d.ts",
      "import": "./dist/casing/toCamelCasedPropertiesDeep.js"
    },
    "./casing/toKebabCasedProperties": {
      "types": "./dist/casing/toKebabCasedProperties.d.ts",
      "import": "./dist/casing/toKebabCasedProperties.js"
    },
    "./casing/toLowerCasedProperties": {
      "types": "./dist/casing/toLowerCasedProperties.d.ts",
      "import": "./dist/casing/toLowerCasedProperties.js"
    },
    "./casing/toPascalCase": {
      "types": "./dist/casing/toPascalCase.d.ts",
      "import": "./dist/casing/toPascalCase.js"
    },
    "./casing/toPascalCasedProperties": {
      "types": "./dist/casing/toPascalCasedProperties.d.ts",
      "import": "./dist/casing/toPascalCasedProperties.js"
    },
    "./casing/toSnakeCasedProperties": {
      "types": "./dist/casing/toSnakeCasedProperties.d.ts",
      "import": "./dist/casing/toSnakeCasedProperties.js"
    },
    "./casing/toUpperCasedProperties": {
      "types": "./dist/casing/toUpperCasedProperties.d.ts",
      "import": "./dist/casing/toUpperCasedProperties.js"
    },
    "./casing/types": {
      "types": "./dist/casing/types.d.ts",
      "import": "./dist/casing/types.js"
    },
    "./cast/*": {
      "types": "./dist/cast/*.d.ts",
      "import": "./dist/cast/*.js"
    },
    "./compact": {
      "types": "./dist/compact.d.ts",
      "import": "./dist/compact.js"
    },
    "./eliminate": {
      "types": "./dist/eliminate.d.ts",
      "import": "./dist/eliminate.js"
    },
    "./realize": {
      "types": "./dist/realize.d.ts",
      "import": "./dist/realize.js"
    },
    "./guard/*": {
      "types": "./dist/guard/*.d.ts",
      "import": "./dist/guard/*.js"
    },
    "./singleton": {
      "types": "./dist/singleton.d.ts",
      "import": "./dist/singleton.js"
    },
    "./substitute": {
      "types": "./dist/substitute.d.ts",
      "import": "./dist/substitute.js"
    },
    "./sumdig": {
      "types": "./dist/sumdig.d.ts",
      "import": "./dist/sumdig.js"
    },
    "./singleflight": {
      "types": "./dist/singleflight.d.ts",
      "import": "./dist/singleflight.js"
    },
    "./tree/cascade": {
      "types": "./dist/tree/cascade.d.ts",
      "import": "./dist/tree/cascade.js"
    },
    "./tree/flat": {
      "types": "./dist/tree/flat.d.ts",
      "import": "./dist/tree/flat.js"
    },
    "./tree/height": {
      "types": "./dist/tree/height.d.ts",
      "import": "./dist/tree/height.js"
    },
    "./tree/leaves": {
      "types": "./dist/tree/leaves.d.ts",
      "import": "./dist/tree/leaves.js"
    },
    "./tree/prune": {
      "types": "./dist/tree/prune.d.ts",
      "import": "./dist/tree/prune.js"
    },
    "./tree/types": {
      "types": "./dist/tree/types.d.ts",
      "import": "./dist/tree/types.js"
    },
    "./tree/unflat": {
      "types": "./dist/tree/unflat.d.ts",
      "import": "./dist/tree/unflat.js"
    },
    "./tree/visit": {
      "types": "./dist/tree/visit.d.ts",
      "import": "./dist/tree/visit.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "momo build",
    "test": "bun test src",
    "format": "biome format --write .",
    "typecheck:spec": "tsc --noEmit --project tsconfig.spec.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "types": "tsc --project tsconfig.build.json"
  },
  "devDependencies": {
    "@momots/cli": "workspace:*"
  },
  "peerDependencies": {
    "remeda": "^2.32.0",
    "type-fest": "5.4.4"
  }
}
