{
  "name": "@momots/design",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./themes/anthropic.css": "./src/themes/anthropic.css"
  },
  "files": [
    "dist",
    "src/themes",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "momo build",
    "test": "bun test src",
    "format": "biome format --write .",
    "typecheck:spec": "tsc --noEmit --project tsconfig.spec.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "types": "tsc --project tsconfig.build.json"
  },
  "devDependencies": {
    "@momots/cli": "workspace:*",
    "@types/react": "^19.2.17"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.6.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@momots/core": ">=0.1.0-alpha.0 <0.2.0",
    "@momots/host": "^0.1.0-alpha.1",
    "@ncdai/wheel-picker": "*",
    "cva": "^1.0.0-beta.4",
    "date-fns": "^4.4.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "remeda": "^2.32.0",
    "tailwind-merge": "^3.6.0",
    "type-fest": "5.4.4"
  },
  "peerDependenciesMeta": {
    "@ncdai/wheel-picker": {
      "optional": true
    }
  },
  "dependencies": {
    "@ncdai/react-wheel-picker": "^1.2.2",
    "motion-plus": "^1.5.1",
    "react-day-picker": "^10.0.1"
  }
}
