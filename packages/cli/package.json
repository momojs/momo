{
  "name": "@momots/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "momo": "./src/bin.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./src/build.ts",
      "bun": "./src/build.ts",
      "import": "./dist/build.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "bun": "./src/config.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun run ./src/bin.ts build",
    "momo": "bun run ./src/bin.ts",
    "typecheck:spec": "tsc --noEmit --project tsconfig.spec.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "types": "tsc --project tsconfig.build.json"
  }
}
